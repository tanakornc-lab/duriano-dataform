config {
    type: "view",
    schema: "analytics_staging",
    name: "stg_play_store_performance",
    description: "Staging: Google Play store listing performance by country for Duriano",
    columns: {
        report_date:                          "วันที่ของ report",
        package_name:                         "Package name ของ app",
        country:                              "รหัสประเทศ",
        store_listing_visitors:               "จำนวน unique users ที่เข้าชม store listing",
        store_listing_acquisitions:           "จำนวน users ที่ install หลังจากเข้าชม listing",
        visitor_to_installer_conversion_rate: "อัตราการแปลงจากผู้เข้าชมเป็น installer (%)"
    }
}

SELECT
    DATE(Date)                               AS report_date,
    Package_Name                             AS package_name,
    Country                                  AS country,
    Store_Listing_Visitors                   AS store_listing_visitors,
    Store_Listing_Acquisitions               AS store_listing_acquisitions,
    Visitor_To_Installer_Conversion_Rate     AS visitor_to_installer_conversion_rate
FROM ${ref("p_Store_Performance_country__duriano")}
WHERE Package_Name = 'com.adisoft.duriano'
