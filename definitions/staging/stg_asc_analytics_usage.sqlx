config {
    type: "view",
    schema: "analytics_staging",
    name: "stg_asc_analytics_usage",
    description: "Staging: App Store Connect analytics — usage metrics (sessions, installs, active devices)",
    columns: {
        date:                 "วันที่ของ metric",
        territory:            "รหัสประเภทประเทศ (ISO 3166-1 alpha-2)",
        device:               "ประเภท device (iPhone, iPad, etc.)",
        platform_version:     "เวอร์ชัน iOS",
        app_version:          "เวอร์ชันของ app",
        event:                "ประเภท usage event เช่น Sessions, Crashes, Active Devices",
        source_type:          "แหล่งที่มา",
        source_info:          "ข้อมูลเพิ่มเติมของ source",
        campaign:             "campaign name ถ้ามี",
        channel:              "channel ที่มาของ install",
        install_type:         "ประเภทของ install",
        download_type:        "ประเภทของ download",
        sessions:             "จำนวน session",
        total_session_duration: "รวม duration ของทุก session (วินาที)",
        unique_devices:       "จำนวน device ที่ unique",
        users_opting_in:      "จำนวน user ที่ opt-in analytics",
        installs:             "จำนวน install",
        downloading_users:    "จำนวน user ที่ download",
        counts:               "จำนวน event ทั้งหมด (general count)",
        install_day:          "วันที่ install",
        app_download_date:    "วันที่ download app",
        _processing_date:     "วันที่ Apple ประมวลผล report",
        _report_name:         "ชื่อ report จาก ASC API",
        _ingested_at:         "เวลาที่ข้อมูลถูก ingest เข้า BigQuery"
    }
}

SELECT
    date,
    COALESCE(territory, '(not set)')        AS territory,
    COALESCE(device, '(not set)')           AS device,
    COALESCE(platform_version, '(not set)') AS platform_version,
    COALESCE(app_version, '(not set)')      AS app_version,
    COALESCE(event, '(not set)')            AS event,
    source_type,
    source_info,
    campaign,
    channel,
    install_type,
    download_type,
    COALESCE(sessions, 0)                   AS sessions,
    COALESCE(total_session_duration, 0)     AS total_session_duration,
    COALESCE(unique_devices, 0)             AS unique_devices,
    COALESCE(users_opting_in, 0)            AS users_opting_in,
    COALESCE(installs, 0)                   AS installs,
    COALESCE(downloading_users, 0)          AS downloading_users,
    COALESCE(counts, 0)                     AS counts,
    install_day,
    app_download_date,
    _processing_date,
    _report_name,
    _ingested_at
FROM ${ref("asc_analytics_usage_raw")}
WHERE date IS NOT NULL
