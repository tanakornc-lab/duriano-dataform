config {
    type: "view",
    schema: "analytics_staging",
    name: "stg_asc_analytics_engagement",
    description: "Staging: App Store Connect analytics — engagement metrics (impressions, product page views, taps) จาก report Standard เท่านั้น, 1 ชุด/วันจาก processing date ล่าสุด",
    columns: {
        report_date:      "วันที่ของ metric",
        country:          "รหัสประเทศ (ISO 3166-1 alpha-2) — renamed from Apple API 'territory'",
        device:           "ประเภท device (iPhone, iPad, etc.)",
        platform_version: "เวอร์ชัน iOS",
        event:            "ประเภท engagement event เช่น Impressions, Product Page Views, App Units",
        engagement_type:  "ประเภทย่อยของ engagement",
        source_type:      "แหล่งที่มาของ traffic (App Store Browse, App Store Search, etc.)",
        source_info:      "ข้อมูลเพิ่มเติมของ source",
        campaign:         "campaign name ถ้ามี",
        page_type:        "ประเภทหน้าที่แสดง",
        page_title:       "ชื่อหน้า",
        counts:           "จำนวน event ทั้งหมด",
        unique_counts:    "จำนวน unique user/device",
        _processing_date: "วันที่ Apple ประมวลผล report",
        _report_name:     "ชื่อ report จาก ASC API",
        _ingested_at:     "เวลาที่ข้อมูลถูก ingest เข้า BigQuery"
    }
}

-- Apple ส่งข้อมูลซ้อนกัน 2 แบบ ต้องกรองไม่งั้นนับซ้ำ:
--   1) report Standard กับ Detailed เป็น event ชุดเดียวกันคนละระดับรายละเอียด → ใช้ Standard อย่างเดียว
--      (Web Preview = การดูหน้าเว็บ apps.apple.com ไม่ใช่ใน App Store — ตัดออก)
--   2) แต่ละ _processing_date มีข้อมูลย้อนหลัง ~3 วัน (ตัวเลขสะสม restate) → ใช้ processing date ล่าสุดของแต่ละวัน
WITH latest AS (
    SELECT
        *,
        MAX(_processing_date) OVER (PARTITION BY date) AS latest_processing_date
    FROM ${ref("asc_analytics_engagement_raw")}
    WHERE _report_name = 'App Store Discovery and Engagement Standard'
)

SELECT
    date                                            AS report_date,
    COALESCE(territory, '(not set)')                AS country,
    COALESCE(device, '(not set)')                   AS device,
    COALESCE(platform_version, '(not set)')         AS platform_version,
    COALESCE(event, '(not set)')                    AS event,
    engagement_type,
    source_type,
    source_info,
    campaign,
    page_type,
    page_title,
    COALESCE(counts, 0)                             AS counts,
    COALESCE(unique_counts, 0)                      AS unique_counts,
    _processing_date,
    _report_name,
    _ingested_at
FROM latest
WHERE
    _processing_date = latest_processing_date
    AND date IS NOT NULL
